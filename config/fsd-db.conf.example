; FSD Python Server Configuration - MySQL mode
; Loads certificates from shared database instead of cert.txt

[system]
clientport = 6809
serverport = 3011
systemport = 3012

; Optional TLS for client port 6809 (both must be set; clients must support TLS)
; tls_cert = /etc/letsencrypt/live/fsd.example.com/fullchain.pem
; tls_key  = /etc/letsencrypt/live/fsd.example.com/privkey.pem
certificates = cert.txt
whazzup = whazzup.txt
serverident = FSD-PY
servername = CWFLY FSD Server
serveremail = admin@cwflysim.cn
serverhost = localhost
serverlocation = China
maxclients = 500

[database]
host = 127.0.0.1
port = 3306
name = cwfly
user = 
password = 

[connections]
; 3011 互联控制面（ADDCERT/KILL）默认关闭；仅在有可信对端时开启
control = 0

[weather]
source = download
